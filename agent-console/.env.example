# Harness: "claude" (Anthropic Managed Agents) or "gemini" (local + Gemini 3 Pro)
AGENT_HARNESS=gemini

# Anthropic (only used when AGENT_HARNESS=claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_BASE=https://api.anthropic.com

# Gemini (only used when AGENT_HARNESS=gemini)
# Free tier key from https://aistudio.google.com/app/apikey
# Shares quota with Gemini CLI (~1500 req/day on Pro).
GEMINI_API_KEY=

# Bash tool — disabled by default for safety. Set to 1 to let agents run
# shell commands on the machine.
ALLOW_BASH_TOOL=0
BASH_TIMEOUT=30

# Console
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8787

# Google Workspace MCP (community server)
# https://github.com/taylorwilsdon/google_workspace_mcp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TRIAGE_LABEL=45black/triaged
