# --- Harness ---------------------------------------------------------------
# "claude" (Anthropic Managed Agents) or "gemini" (Gemini 3 Pro)
AGENT_HARNESS=gemini

# --- Persistence -----------------------------------------------------------
# "sqlite" (local) or "firestore" (Cloud Run). Auto-detects firestore when
# K_SERVICE is present (i.e. running on Cloud Run).
STORE_BACKEND=sqlite

# --- Inference mode --------------------------------------------------------
# Leave unset to auto-detect: Vertex AI when GOOGLE_CLOUD_PROJECT is set,
# AI Studio otherwise. Force explicitly with "1" or "0".
# GEMINI_USE_VERTEX=1

# AI Studio free-tier key (only if running locally, outside GCP)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Vertex AI (on GCP / Cloud Run). project = billing project, location must
# be a region where Gemini 3 Pro is served.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1

# Override model if needed (default: gemini-3-pro)
# GEMINI_MODEL=gemini-3-pro

# --- Claude harness (only if AGENT_HARNESS=claude) ------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com

# --- Console ---------------------------------------------------------------
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8787

# --- Tools -----------------------------------------------------------------
# Bash tool — disabled by default for safety. 1 = allow agent to run shell.
ALLOW_BASH_TOOL=0
BASH_TIMEOUT=30

# MCP gateway — bearer token checked by the MCP servers themselves.
# On Cloud Run this is supplied via Secret Manager (see deploy/service.yaml).
MCP_GATEWAY_TOKEN=

# When set, MCP bridge uses the _local_dev_url from mcp/servers.json
# instead of the tunnel URL. Useful on the Mac mini when MCPs run next door.
# MCP_USE_LOCAL=1

# Google Workspace MCP (community server)
# https://github.com/taylorwilsdon/google_workspace_mcp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TRIAGE_LABEL=45black/triaged
